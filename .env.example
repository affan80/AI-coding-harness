# Shared model-client configuration (see harness/model/config.py).
# Copy to `.env` locally if your tooling loads one; NEVER commit real values.

# Provider: openai | anthropic | fake (fake = deterministic offline client, default)
HARNESS_MODEL_PROVIDER=fake

# Model id; context-window/output limits are discovered automatically.
HARNESS_MODEL=

# Credentials (harness-prefixed names win over the plain ones).
HARNESS_OPENAI_API_KEY=
HARNESS_ANTHROPIC_API_KEY=

# Optional overrides.
# HARNESS_MODEL_BASE_URL=https://api.openai.com/v1
# HARNESS_MODEL_TIMEOUT_SECONDS=60
# HARNESS_MODEL_CONTEXT_WINDOW_TOKENS=
# HARNESS_MODEL_MAX_OUTPUT_TOKENS=
